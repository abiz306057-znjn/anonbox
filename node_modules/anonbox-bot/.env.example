# ============================================================
#  AnonBox v3.0 — نمونه فایل محیطی
#  این فایل رو کپی کن به .env و مقادیر واقعی رو جایگزین کن
# ============================================================

# ===== ربات تلگرام =====
# توکن ربات رو از @BotFather بگیر
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# یوزرنیم ربات (بدون @)
BOT_USERNAME=AnonBoxBot

# ===== ادمین =====
# آیدی عددی خودت رو از @userinfobot بگیر
ADMIN_ID=123456789

# ===== دیتابیس =====
# مسیر دیتابیس SQLite (نسبی یا مطلق)
DB_PATH=./data/anonbox.db

# ===== سرور HTTP =====
# هاست سرور (0.0.0.0 برای همه interfaceها)
SERVER_HOST=0.0.0.0

# پورت سرور
SERVER_PORT=3000

# آدرس WebApp (در production باید HTTPS باشه)
WEBAPP_URL=http://localhost:3000

# منبع CORS (اختیاری — پیش‌فرض *)
CORS_ORIGIN=*

# ===== بسته‌های اشتراک (به Telegram Stars) =====
# بسته یک هفته‌ای (۷ روز)
PRICE_WEEKLY=40

# بسته ماهانه (۳۰ روز)
PRICE_MONTHLY=120

# بسته سالانه (۳۶۵ روز)
PRICE_YEARLY=1000

# بسته پاسخ ناشناس (۳۰ روز)
PRICE_REPLY=400

# ===== سیستم رایگان روزانه =====
# تعداد پیام رایگان روزانه برای کاربران بدون بسته
FREE_DAILY_MESSAGES=10

# ===== حالت اجرا =====
# development یا production
NODE_ENV=development